{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "outDir": "output/assets/ts",
    "rootDir": "src/ts",
    "sourceMap": false,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*.ts"]
}
